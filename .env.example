# Variáveis de ambiente de exemplo
# Copie este arquivo para .env.local e preencha os valores

# URL do webhook n8n de PRODUÇÃO (não usar /webhook-test/)
# Em produção na Vercel, adicione em Settings > Environment Variables > Production
NEXT_PUBLIC_LEAD_WEBHOOK_URL=https://n8n.globalportfolio.com.br/webhook/portfolio

# Para desenvolvimento local, aponte para um servidor de teste (ex.: node http server em outra porta)
# NEXT_PUBLIC_LEAD_WEBHOOK_URL=http://localhost:3001/webhook